{
  "id": null,
  "uid": "minicdn-dashboard",
  "title": "Mini CDN Overview",
  "tags": [
    "cdn",
    "prometheus"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "hideControls": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "id": 1,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "(sum(rate(http_requests_total{job=\"mini-cdn-edges\",path!~\"/health|/internal/.*\",cache_status=\"HIT\"}[1m])) or vector(0)) / clamp_min((sum(rate(http_requests_total{job=\"mini-cdn-edges\",path!~\"/health|/internal/.*\"}[1m])) or vector(0)), 0.000001) * 100",
          "refId": "A",
          "legendFormat": "Hit Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        }
      },
      "description": "Content-response HIT percentage over the last minute. Health and purge traffic are excluded. Coalesced followers count as HIT; idle windows show zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "type": "stat",
      "title": "Active Edge Nodes",
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max(router_active_nodes)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Healthy edge count (maximum across policy routers, not their sum)."
    },
    {
      "type": "bargauge",
      "title": "Cache Sizes (Items cached per node)",
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "cache_size_items{job=\"mini-cdn-edges\"}",
          "refId": "A",
          "legendFormat": "{{node_id}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "description": "Stored entries per edge, not bytes. Expired entries can remain until looked up.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "type": "timeseries",
      "title": "RPS per Edge Node",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (node_id) (rate(http_requests_total{job=\"mini-cdn-edges\",path!~\"/health|/internal/.*\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{node_id}}"
        }
      ],
      "description": "Content requests per second, averaged over one minute. Hash ownership can make small workloads uneven.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "type": "timeseries",
      "title": "Hits vs Misses vs Bypasses",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (cache_status) (rate(http_requests_total{job=\"mini-cdn-edges\",path!~\"/health|/internal/.*\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{cache_status}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      }
    },
    {
      "id": 6,
      "title": "Origin fetches since edge start",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(cdn_origin_requests_total{job=\"mini-cdn-edges\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Origin fetch operations, including misses and bypasses. Counters reset when an edge restarts.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 7,
      "title": "Coalesced requests since edge start",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(cdn_coalesced_requests_total{job=\"mini-cdn-edges\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "Initial misses reused a cache filled by another request. Buffered coordination only; counters reset on edge restart.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "id": 8,
      "title": "Estimated edge P95 latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "histogram_quantile(0.95, sum by (le,node_id) (rate(http_request_duration_seconds_bucket{job=\"mini-cdn-edges\",path!~\"/health|/internal/.*\"}[1m])))",
          "refId": "A",
          "legendFormat": "{{node_id}}"
        }
      ],
      "description": "Estimated P95 from histogram buckets at the edge. Excludes health and purge; does not include the full client-to-router round trip. Idle nodes have no percentile.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 9,
      "title": "Content responses since edge start",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (cache_status) (http_requests_total{job=\"mini-cdn-edges\",path!~\"/health|/internal/.*\"})",
          "refId": "A",
          "legendFormat": "{{cache_status}}",
          "instant": true
        }
      ],
      "description": "Cumulative content responses by cache status. Useful after a short demo when request rates return to zero.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "type": "timeseries",
      "title": "Cached response-body bytes",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "cache_body_bytes{job=\"mini-cdn-edges\"}",
          "refId": "A",
          "legendFormat": "{{node_id}}"
        }
      ],
      "description": "Content requests per second, averaged over one minute. Hash ownership can make small workloads uneven.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Capacity evictions per second",
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "rate(cache_evictions_total{job=\"mini-cdn-edges\"}[1m])",
          "refId": "A",
          "legendFormat": "{{node_id}}"
        }
      ],
      "description": "Content requests per second, averaged over one minute. Hash ownership can make small workloads uneven.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Routing policy requests per second",
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum by (routing_mode) (rate(router_requests_total{path!~\"/health|/metrics\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{routing_mode}}"
        }
      ],
      "description": "Content requests per second, averaged over one minute. Hash ownership can make small workloads uneven.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Router in-flight requests per edge",
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "router_inflight_requests{job=\"mini-cdn-router\"}",
          "refId": "A",
          "legendFormat": "{{instance}} / {{node_id}}"
        }
      ],
      "description": "Content requests per second, averaged over one minute. Hash ownership can make small workloads uneven.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "version": 3
}
