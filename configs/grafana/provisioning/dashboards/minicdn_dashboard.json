{
  "id": null,
  "uid": "minicdn-dashboard",
  "title": "Mini CDN Overview",
  "tags": ["cdn", "prometheus"],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "hideControls": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "gauge",
      "title": "Cache Hit Ratio",
      "id": 1,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(sum(rate(http_requests_total{cache_status=\"HIT\"}[1m])) or vector(0)) / (sum(rate(http_requests_total[1m])) or vector(0.000001)) * 100",
          "refId": "A",
          "legendFormat": "Hit Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Edge Nodes",
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "router_active_nodes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "type": "bargauge",
      "title": "Cache Sizes (Items cached per node)",
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "cache_size_items",
          "refId": "A",
          "legendFormat": "{{node_id}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      }
    },
    {
      "type": "timeseries",
      "title": "RPS per Edge Node",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_requests_total[10s])) by (node_id)",
          "refId": "A",
          "legendFormat": "{{node_id}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Hits vs Misses vs Bypasses",
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_requests_total[10s])) by (cache_status)",
          "refId": "A",
          "legendFormat": "{{cache_status}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "time": {
    "from": "now-5m",
    "to": "now"
  }
}
